{%- comment -%}
  Lou, en bas de l'écran : petite bulle qui parle selon la page, et mini-conversation
  à réponses toutes prêtes (aucune IA en direct). Aucune mention IA (décision utilisateur 06/11).
{%- endcomment -%}
<div class="lou-assist" id="lou-assist">
  <section class="lou-panel" id="lou-panel" role="dialog" aria-label="Discuter avec Lou" aria-hidden="true">
    <header class="lou-panel-head">
      <img src="{{ 'lou-avatar.webp' | asset_url }}" alt="" width="42" height="42" loading="lazy">
      <div><b>Lou</b><span>Je vous guide ✨</span></div>
      <button type="button" id="lou-fermer" aria-label="Fermer la conversation">✕</button>
    </header>
    <div class="lou-fil" id="lou-fil" aria-live="polite"></div>
    <div class="lou-choix" id="lou-choix"></div>
    <p class="lou-legal">Une vraie question ? <a href="/pages/contact">Écrivez-nous</a>, l'équipe vous répond.</p>
  </section>
  <div class="lou-teaser" id="lou-teaser" hidden role="status"><b class="nom">Lou</b><p></p><button class="lou-teaser-x" type="button" aria-label="Masquer le message">✕</button></div>
  <button class="lou-btn" id="lou-btn" type="button" aria-expanded="false" aria-controls="lou-panel" aria-label="Discuter avec Lou">
    <img src="{{ 'lou-avatar.webp' | asset_url }}" alt="" width="62" height="62"><span class="en-ligne" aria-hidden="true"></span><span class="pastille-n" id="lou-n" hidden>1</span>
  </button>
</div>
