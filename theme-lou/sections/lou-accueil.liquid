{%- assign jonc = all_products['jonc-mes-mots'] -%}
{%- assign url_jonc = jonc.url | default: '/products/jonc-mes-mots' -%}
{%- capture trait -%}<svg class="trait" viewBox="0 0 200 20" preserveAspectRatio="none" aria-hidden="true"><path d="M3 14 C 50 4, 120 4, 197 11"/></svg>{%- endcapture -%}

{%- comment -%} 1. Lou se présente + atelier de gravure en direct {%- endcomment -%}
<section class="hero">
  <div class="wrap hero-in">
    <div class="hero-visu">
      <div class="scene-lou" id="scene-lou">
        <span class="rond" aria-hidden="true"></span>
        <span class="eclat e1" aria-hidden="true">✦</span><span class="eclat e2" aria-hidden="true">✧</span><span class="eclat e3" aria-hidden="true">✦</span>
        <img class="pose on" data-pose="coucou" src="{{ 'lou-pose-coucou.webp' | asset_url }}" alt="Lou, l'avatar de la boutique, fait coucou ; elle porte son collier prénom « Lou » et son jonc gravé" width="2400" height="2933" fetchpriority="high" decoding="async">
        <img class="pose" data-pose="gauche" src="{{ 'lou-pose-pointe-gauche.webp' | asset_url }}" alt="" aria-hidden="true" width="2400" height="2933" decoding="async">
        <img class="pose" data-pose="bas-gauche" src="{{ 'lou-pose-bas-gauche.webp' | asset_url }}" alt="" aria-hidden="true" width="2400" height="2933" decoding="async">
        <img class="pose" data-pose="haut-droite" src="{{ 'lou-pose-haut-droite.webp' | asset_url }}" alt="" aria-hidden="true" width="2400" height="2933" decoding="async">
        <img class="pose" data-pose="bas-droite" src="{{ 'lou-pose-bas-droite.webp' | asset_url }}" alt="" aria-hidden="true" width="2400" height="2933" decoding="async">
        <a class="bijou b-jonc" data-cote="gauche" data-dit="Le jonc, gravé avec vos mots 💗" href="{{ url_jonc }}"><span class="rondelle"><img src="{{ 'pastille-jonc.webp' | asset_url }}" alt="" width="1000" height="1000" decoding="async"></span><span class="tag">le jonc gravé</span></a>
        <a class="bijou b-photo" data-cote="bas-gauche" data-dit="Le collier photo : votre photo cachée dans le cœur 📸" href="/products/collier-souvenir-photo"><span class="rondelle"><img src="{{ 'pastille-collier-photo.webp' | asset_url }}" alt="" width="1000" height="1000" decoding="async"></span><span class="tag">le collier photo</span></a>
        <a class="bijou b-prenom" data-cote="haut-droite" data-dit="Le collier prénom, en écriture manuscrite ✨" href="/products/collier-prenom"><span class="rondelle"><img src="{{ 'pastille-collier-prenom.webp' | asset_url }}" alt="" width="1000" height="1000" decoding="async"></span><span class="tag">le collier prénom</span></a>
        <a class="bijou b-morse" data-cote="bas-droite" data-dit="Le bracelet Code Secret : un mot caché en Morse 🤫" href="/products/bracelet-code-secret"><span class="rondelle"><img src="{{ 'pastille-morse.webp' | asset_url }}" alt="" width="1000" height="1000" decoding="async"></span><span class="tag">le code secret</span></a>
        <div class="sticker s2"><span aria-hidden="true">🎁</span> 2e bijou à -50 %</div>
      </div>
      <div class="lou-dit">
        <span class="avatar"><img src="{{ 'lou-avatar.webp' | asset_url }}" alt="" width="58" height="58"></span>
        <div class="bulle-lou"><b class="nom">Lou <small>· l'avatar de la boutique</small></b><p id="lou-intro" data-texte="Coucou, moi c'est Lou ! 👋 Voici mes bijoux préférés.">Coucou, moi c'est Lou ! 👋 Voici mes bijoux préférés.</p></div>
      </div>
    </div>
    <div class="hero-txt">
      <span class="eyebrow">💍 Bijoux personnalisés</span>
      <h1><span class="ligne"><span>Vos mots,</span></span><span class="ligne"><span><em><span class="t">gravés pour toujours.</span>{{ trait }}</em></span></span></h1>
      <div class="atelier" id="atelier">
        <div class="atelier-haut">
          <label for="atelier-texte">✍️ Essayez vos mots :</label>
          <div class="pastilles" role="radiogroup" aria-label="Finition du jonc">
            <button type="button" class="p-argentee is-on" data-fin="" role="radio" aria-checked="true" aria-label="Argentée"></button>
            <button type="button" class="p-doree" data-fin="-doree" role="radio" aria-checked="false" aria-label="Dorée"></button>
            <button type="button" class="p-rosee" data-fin="-rosee" role="radio" aria-checked="false" aria-label="Rosée"></button>
          </div>
        </div>
        <div class="atelier-row">
          <input id="atelier-texte" type="text" maxlength="20" placeholder="Vos mots ici…" autocomplete="off" enterkeyhint="go">
          <a class="btn btn-small" id="atelier-lien" data-base="{{ url_jonc }}" href="{{ url_jonc }}#personnaliser">Graver ✨</a>
        </div>
        <div class="atelier-photo" id="atelier-apercu" data-base="{{ 'jonc-vierge.webp' | asset_url }}" data-doree="{{ 'jonc-vierge-doree.webp' | asset_url }}" data-rosee="{{ 'jonc-vierge-rosee.webp' | asset_url }}">
          <img src="{{ 'jonc-vierge.webp' | asset_url }}" alt="Le Jonc « Mes Mots » avec votre texte gravé" width="1080" height="540" decoding="async">
          <canvas id="atelier-gravure" aria-hidden="true"></canvas>
          <span class="etincelle" id="etincelle" aria-hidden="true"></span>
        </div>
        <p class="atelier-note">Aperçu indicatif · 20 caractères max.</p>
      </div>
      <div class="hero-cta">
        <a class="btn" id="atelier-cta" href="{{ url_jonc }}#personnaliser"><span class="brille"></span>Je crée mon bijou</a>
        <a class="btn ghost" href="#le-test">Lou, aide-moi ✨</a>
      </div>
    </div>
  </div>
</section>

<div class="ticker-zone" aria-hidden="true"><div class="ticker"><div class="ticker-track">
  {%- for i in (1..2) -%}<span>Tu es ma personne</span><span>Sœurs pour toujours</span><span>Merci pour tout, maman</span><span>12.07.2019</span><span>Toi, toujours</span><span>Ma partenaire de bêtises</span><span>Crois en toi</span><span>Même loin, tout près</span>{%- endfor -%}
</div></div></div>

{%- comment -%} 2. Les coups de cœur de Lou {%- endcomment -%}
<section class="section" id="bijoux">
  <div class="wrap">
    <div class="head rv">
      <h2>Choisissez <em><span class="t">votre bijou</span>{{ trait }}</em></h2>
    </div>
    <div class="grille" id="grille-accueil" style="position:relative">
      {%- for p in collections.all.products limit: 8 -%}
        {% render 'carte-produit', p: p %}
      {%- endfor -%}
    </div>
  </div>
</section>

{%- comment -%} 3. La machine à mots (juste sous les bijoux) {%- endcomment -%}
<section class="section band" id="machine-a-mots">
  <div class="wrap machine">
    <div class="rv">
      <span class="hand">Pas d'idée ?</span>
      <h2>Ma machine <em><span class="t">à mots</span>{{ trait }}</em></h2>
      <p class="small" style="margin-top:12px">Tirez la manette, gravez la phrase qui vous plaît.</p>
    </div>
    {% render 'machine-mots', produit: url_jonc, mode: 'lien' %}
  </div>
</section>

{%- comment -%} 4. Le test des mots (conversation avec Lou) {%- endcomment -%}
<section class="section band" id="le-test">
  <div class="wrap">
    <div class="head rv">
      <h2>Je vous aide <em><span class="t">à choisir</span>{{ trait }}</em></h2>
      <p>4 questions, 30 secondes.</p>
    </div>
    {% render 'test-mots' %}
  </div>
</section>

{%- comment -%} 6. Comment ça marche {%- endcomment -%}
<section class="section">
  <div class="wrap">
    <div class="head rv"><h2>Comment ça <em><span class="t">marche</span>{{ trait }}</em> ?</h2></div>
    <div class="etapes">
      <div class="etape rv" data-n="1"><span class="emo" aria-hidden="true">✍️</span><h3>Vous écrivez</h3><p>Phrase, prénom, photo ou mot secret.</p></div>
      <div class="etape rv" data-n="2"><span class="emo" aria-hidden="true">✨</span><h3>L'atelier grave</h3><p>Fabriqué rien que pour vous.</p></div>
      <div class="etape rv" data-n="3"><span class="emo" aria-hidden="true">🎁</span><h3>Vous recevez</h3><p>En {{ settings.liv_min | default: 5 }} à {{ settings.liv_max | default: 10 }} jours, avec suivi.</p></div>
    </div>
    <p class="glisser">← glissez →</p>
  </div>
</section>

{%- comment -%} 7. C'est moi, Lou {%- endcomment -%}
<section class="section band">
  <div class="wrap lou">
    <figure class="lou-photo rv">
      <img src="{{ 'lou-portrait.webp' | asset_url }}" alt="Portrait de Lou, l'avatar de la boutique" width="1000" height="1250" loading="lazy">
      <figcaption>C'est moi, Lou ✨</figcaption>
    </figure>
    <div class="rv">
      <span class="hand">Enchantée !</span>
      <h2>Les mots qu'on n'ose pas dire, <em><span class="t">on les grave</span>{{ trait }}</em></h2>
      <div class="lou-note" style="margin-top:18px">
        <p>Un « merci », un « je t'aime », un prénom… pour qu'ils restent. — Lou 💗</p>
      </div>
      <p style="margin-top:14px"><a class="btn ghost btn-small" href="/pages/qui-est-lou">Qui est Lou ?</a></p>
    </div>
  </div>
</section>

{%- comment -%} 8. Compte à rebours Noël {%- endcomment -%}
<section class="section">
  <div class="wrap">
    <div class="noel rv" id="noel" data-limite="{{ settings.noel_iso | default: '2026-12-10' }}">
      <div class="neige" aria-hidden="true"></div>
      <h2>Pour l'avoir sous <em>le sapin</em></h2>
      <p>Commandez avant le <b>{{ settings.noel_limite | default: '10 décembre' }}</b>.</p>
      <div class="compte" aria-live="off"><div><b data-u="j">–</b><small>jours</small></div><div><b data-u="h">–</b><small>heures</small></div><div><b data-u="m">–</b><small>min</small></div><div><b data-u="s">–</b><small>sec</small></div></div>
      <a class="btn" href="/collections/all"><span class="brille"></span>Je choisis maintenant 🎄</a>
    </div>
  </div>
</section>

{%- comment -%} 9. Réassurance {%- endcomment -%}
<section class="section band" style="padding-block:40px">
  <div class="wrap">
    <div class="reassure">
      <div class="rv"><span class="emo" aria-hidden="true">👀</span>Aperçu en direct<small>avant de commander</small></div>
      <div class="rv"><span class="emo" aria-hidden="true">🚚</span>Livraison suivie<small>France &amp; Belgique</small></div>
      <div class="rv"><span class="emo" aria-hidden="true">💧</span>Acier inoxydable<small>ne noircit pas</small></div>
      <div class="rv"><span class="emo" aria-hidden="true">🔒</span>Paiement sécurisé<small>CB, PayPal, Apple Pay</small></div>
    </div>
  </div>
</section>

{%- comment -%} 10. FAQ en conversation {%- endcomment -%}
<section class="section">
  <div class="wrap">
    <div class="head rv"><h2>Vos <em><span class="t">questions</span>{{ trait }}</em></h2></div>
    {% render 'faq', court: true %}
    <p style="text-align:center;margin-top:18px"><a class="btn ghost btn-small" href="/pages/faq">Toutes les questions</a></p>
  </div>
</section>

{% schema %}
{ "name": "Accueil Les Mots de Lou", "settings": [] }
{% endschema %}
