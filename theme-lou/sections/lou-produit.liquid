{%- assign c = product.metafields.lou.contenu.value -%}
{%- assign v0 = product.selected_or_first_available_variant -%}
{%- assign type = c.apercu | default: 'jonc' -%}
{%- liquid
  case type
    when 'jonc'
      assign conseil = "10 à 20 caractères, c'est parfait 💗"
    when 'prenom'
      assign conseil = "Joli ! 3 à 8 lettres, c'est idéal ✨"
    when 'photo'
      assign conseil = "Belle photo ! C'est parfait 📸"
    when 'morse'
      assign conseil = "Chut… 4 à 6 lettres, c'est idéal 🤫"
  endcase
-%}
<div class="wrap fiche" id="fiche" data-apercu="{{ type }}"
  data-img-base="{% if type == 'jonc' %}{{ 'jonc-carre.webp' | asset_url }}{% elsif type == 'prenom' %}{{ 'collier-vierge.webp' | asset_url }}{% elsif type == 'photo' %}{{ 'collier-photo.webp' | asset_url }}{% endif %}"
  data-img-doree="{% if type == 'jonc' %}{{ 'jonc-carre-doree.webp' | asset_url }}{% elsif type == 'prenom' %}{{ 'collier-vierge-doree.webp' | asset_url }}{% endif %}"
  data-img-rosee="{% if type == 'jonc' %}{{ 'jonc-carre-rosee.webp' | asset_url }}{% elsif type == 'prenom' %}{{ 'collier-vierge-rosee.webp' | asset_url }}{% endif %}">
  <div class="fiche-galerie">
    <button class="coeur coeur-fiche" type="button" data-handle="{{ product.handle }}" aria-label="Ajouter {{ product.title | escape }} à mes coups de cœur"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7.5-4.6-9.5-9.2C1 8.2 3.4 4.5 7 4.5c2 0 3.6 1.1 5 3 1.4-1.9 3-3 5-3 3.6 0 6 3.7 4.5 7.3C19.5 16.4 12 21 12 21z"/></svg></button>
    <div class="galerie" id="galerie" tabindex="0" aria-label="Images du bijou (glissez pour voir les photos)">
      <div class="slide vue-apercu" id="vue-apercu" data-i="-1"><span class="etiquette-apercu">✍️ Aperçu en direct · simulation</span><div class="scene" id="scene" aria-live="polite"></div></div>
      {%- for img in product.images -%}
        <div class="slide" data-i="{{ forloop.index0 }}">{{ img | image_url: width: 1400 | image_tag: alt: product.title, loading: 'lazy', widths: '600,900,1200,1400', sizes: '(min-width: 960px) 50vw, 100vw' }}</div>
      {%- endfor -%}
    </div>
    <div class="galerie-nav" role="tablist" aria-label="Choisir une image">
      <button class="v-apercu is-on" type="button" data-vue="-1" aria-label="Votre aperçu">✍️<br>Mon<br>aperçu</button>
      {%- for img in product.images -%}
        <button type="button" data-vue="{{ forloop.index0 }}" aria-label="Photo {{ forloop.index }}">{{ img | image_url: width: 240 | image_tag: alt: '', loading: 'lazy' }}</button>
      {%- endfor -%}
    </div>
    <p class="tiny pas-mobile">Aperçu indicatif · photos non contractuelles.</p>
  </div>

  <div class="fiche-info">
    <span class="eyebrow">💗 Personnalisé pour vous</span>
    <h1>{{ product.title }}</h1>
    {%- if c.accroche %}<p class="hand" style="margin:0">{{ c.accroche }}</p>{% endif -%}
    <div class="fiche-prix"><span class="prix" id="prix">{{ v0.price | money }}</span><span class="etiquette">Prix de lancement</span><span class="duo-prix">🎁 le 2e bijou à -50 %</span></div>

    <form id="form-produit" action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" novalidate>
      <input type="hidden" name="id" id="variante" value="{{ v0.id }}">
      <input type="hidden" name="quantity" value="1">
      <div class="bloc">
        {%- assign num = 1 -%}
        {%- unless product.has_only_default_variant or product.variants.size == 1 -%}
          <div>
            <div class="bloc-titre"><span>{{ num }}. {{ product.options.first }} : <span id="finition-nom">{{ v0.option1 }}</span></span></div>
            <div class="finitions" style="margin-top:10px;--n:{{ product.variants.size }}" role="radiogroup" aria-label="{{ product.options.first }}">
              {%- for v in product.variants -%}
                {%- liquid
                  assign coul = '#d8d8de'
                  case v.option1
                    when 'Dorée'
                      assign coul = 'linear-gradient(135deg,#fff1c9,#d7a647)'
                    when 'Rosée'
                      assign coul = 'linear-gradient(135deg,#ffe4dc,#d99a8c)'
                    when 'Argentée'
                      assign coul = 'linear-gradient(135deg,#ffffff,#b9bcc6)'
                    when 'Noir'
                      assign coul = '#222'
                  endcase
                -%}
                <button type="button" class="finition{% if v.id == v0.id %} is-on{% endif %}" role="radio" aria-checked="{% if v.id == v0.id %}true{% else %}false{% endif %}" data-id="{{ v.id }}" data-nom="{{ v.option1 | escape }}" data-prix="{{ v.price | money }}"><span class="pastille" style="background:{{ coul }}"></span>{{ v.option1 }}</button>
              {%- endfor -%}
            </div>
          </div>
          {%- assign num = num | plus: 1 -%}
        {%- else -%}
          {%- if product.variants.size == 1 and product.options.first != 'Title' -%}<p class="small" style="margin:0">{{ product.options.first }} : <b>{{ v0.option1 }}</b></p>{%- endif -%}
        {%- endunless -%}

        {%- for f in c.perso -%}
          {%- case f.type -%}
            {%- when 'texte' -%}
              <div class="champ">
                <label for="p-{{ forloop.index }}"><span>{{ num }}. {{ f.cle }}{% if f.requis %} *{% endif %}</span><small class="compteur" data-max="{{ f.max }}">0 / {{ f.max }}</small></label>
                <input type="text" id="p-{{ forloop.index }}" class="perso-texte{% if f.majuscules %} maj{% endif %}" name="properties[{{ f.cle }}]" maxlength="{{ f.max }}" placeholder="Ex. : {{ f.exemple }}" {% if f.requis %}required{% endif %} autocomplete="off" autocapitalize="{% if f.majuscules %}characters{% else %}sentences{% endif %}" enterkeyhint="done" data-principal="{% if forloop.first %}1{% endif %}">
                {%- if forloop.first %}<p class="lou-mini" hidden><img src="{{ 'lou-avatar.webp' | asset_url }}" alt="" width="26" height="26" loading="lazy"><span><b>Lou :</b> {{ conseil }}</span></p>{% endif -%}
                {%- if type == 'jonc' -%}
                  <div class="suggestions" aria-label="Idées de Lou"><button type="button" class="idee" data-idee="1">🎲 Lou, une idée !</button><button type="button">Tu es ma personne</button><button type="button">Sœurs pour toujours</button><button type="button">Merci maman</button><button type="button">Toi, toujours</button><button type="button">Crois en toi</button></div>
                {%- elsif type == 'prenom' -%}
                  <p class="tiny" style="margin:0">Majuscule au début, accents acceptés (é, è, ë…). 10 lettres maximum.</p>
                {%- elsif type == 'morse' -%}
                  <div class="suggestions" aria-label="Idées de Lou"><button type="button">TOUJOURS</button><button type="button">NOUS</button><button type="button">AMIES</button><button type="button">MAMAN</button><button type="button">COURAGE</button></div>
                  <p class="tiny" style="margin:0">Lettres A à Z, sans accent. Chaque lettre devient un petit groupe de perles rondes et longues : votre code secret 🤫</p>
                {%- endif -%}
              </div>
            {%- when 'choix' -%}
              <div class="champ">
                <label><span>{{ num }}. {{ f.cle }}</span></label>
                <input type="hidden" name="properties[{{ f.cle }}]" id="police" value="{{ f.valeurs.first }}">
                <div class="finitions" style="--n:{{ f.valeurs.size }}" role="radiogroup" aria-label="{{ f.cle }}">
                  {%- for val in f.valeurs -%}
                    <button type="button" class="finition police-btn{% if forloop.first %} is-on{% endif %}" role="radio" aria-checked="{% if forloop.first %}true{% else %}false{% endif %}" data-police="{{ val }}"><span class="grave {{ val | downcase }}" style="font-family:{% if val == 'Manuscrite' %}var(--f-grave-manuscrite);font-size:1.35rem{% elsif val == 'Classique' %}var(--f-grave-classique);letter-spacing:.12em{% else %}var(--f-grave-moderne);letter-spacing:.08em{% endif %}">{% if val == 'Manuscrite' %}Abc{% else %}ABC{% endif %}</span>{{ val }}</button>
                  {%- endfor -%}
                </div>
              </div>
            {%- when 'photo' -%}
              <div class="champ">
                <label for="p-photo"><span>{{ num }}. Votre photo *</span></label>
                <label class="depot" id="depot" for="p-photo">
                  <span style="font-size:2rem" aria-hidden="true">📸</span>
                  <b>Choisir une photo</b>
                  <span class="tiny" style="margin:0">Nette, lumineuse, visages au centre (JPG, PNG, HEIC)</span>
                  <input type="file" id="p-photo" name="properties[{{ f.cle }}]" accept="image/jpeg,image/png,image/heic,image/webp" required>
                </label>
                <p class="lou-mini" hidden><img src="{{ 'lou-avatar.webp' | asset_url }}" alt="" width="26" height="26" loading="lazy"><span><b>Lou :</b> {{ conseil }}</span></p>
              </div>
          {%- endcase -%}
          {%- assign num = num | plus: 1 -%}
        {%- endfor -%}

        <div class="recap-gravure" id="recap" hidden>Vous avez écrit : <b id="recap-texte"></b></div>
        {%- unless type == 'photo' -%}
        <label class="verif" id="verif-l"><input type="checkbox" id="verif" required checked> <span>J'ai vérifié l'orthographe : mon bijou sera fabriqué exactement comme je l'ai écrit.</span></label>
        {%- endunless -%}
        <button class="btn btn-full" type="submit" id="ajouter"><span class="brille"></span>Ajouter au panier · <span id="prix-btn">{{ v0.price | money }}</span></button>
        <p class="tiny" id="form-erreur" role="alert" style="color:var(--framboise-f);margin:0"></p>
      </div>
    </form>

    <div class="delai">
      <span class="estim" id="estim">🚚 Livraison estimée : calcul en cours…</span>
      <span>🎄 <b>Pour Noël</b> : commandez avant le <b>{{ settings.noel_limite | default: '10 décembre' }}</b></span>
    </div>
    <div class="duo-pub"><span aria-hidden="true">🎁</span><span>2e bijou à <b>-50 %</b>, automatiquement</span></div>

    <div class="accordeons">
      {%- if c.benefices -%}<details open><summary>Caractéristiques</summary><div><ul class="benefices">{%- for b in c.benefices -%}<li>{{ b }}</li>{%- endfor -%}{% if settings.ecrin_inclus %}<li>Livré dans un écrin cadeau, prêt à offrir</li>{% endif %}</ul><p class="tiny">Aperçu indicatif · photos non contractuelles.</p></div></details>{%- endif -%}
      {%- if type == 'jonc' or type == 'morse' -%}
        <div class="machine-fiche">
          <span class="hand">En panne d'inspiration ?</span>
          <h3>Ma machine à {% if type == 'morse' %}mots secrets{% else %}mots{% endif %}</h3>
          {%- if type == 'morse' %}{% render 'machine-mots', produit: product.url, mode: 'remplir', sorte: 'mot' %}{% else %}{% render 'machine-mots', produit: product.url, mode: 'remplir', sorte: 'phrase' %}{% endif -%}
        </div>
      {%- endif -%}
      {%- if product.description != blank -%}<details><summary>Le bijou</summary><div>{{ product.description }}</div></details>{%- endif -%}
      <details><summary>Matière &amp; entretien</summary><div>
        {%- case type -%}
          {%- when 'photo' -%}Chaîne en acier inoxydable, pendentif cœur en métal plaqué avec lentille photo. Les finitions dorée et rosée sont des finitions colorées (ce n'est pas de l'or). Évitez l'eau, le parfum et les chocs sur la lentille ; rangez-le à l'abri.
          {%- when 'morse' -%}Perles métalliques argentées sur cordon tressé réglable. Évitez de le mouiller trop souvent pour garder le cordon joli ; rangez-le à plat.
          {%- else -%}Acier inoxydable : il ne noircit pas et supporte l'eau du quotidien. Les finitions dorée et rosée sont des finitions colorées sur acier (ce n'est pas de l'or). Pour garder l'éclat, évitez le parfum directement sur le bijou.
        {%- endcase -%}
      </div></details>
      <details><summary>Livraison</summary><div>Votre bijou est fabriqué à la commande puis livré en France et en Belgique en {{ settings.liv_min | default: 5 }} à {{ settings.liv_max | default: 10 }} jours au total (fabrication comprise), avec numéro de suivi. <a href="/pages/livraison-retours">Tout savoir</a>.</div></details>
      <details><summary>Retours &amp; garantie</summary><div>Ce bijou est fabriqué selon vos indications : il ne bénéficie pas du droit de rétractation (art. L221-28 du Code de la consommation). Vous restez couverte par la garantie légale de conformité : un souci à la réception ? Écrivez-nous avec une photo, on trouve une solution. Avec la « Livraison + Garantie 2 mois 🛡️ » (7,90 €, au paiement), vous avez 2 mois pour le renvoyer, même personnalisé (<a href="/policies/refund-policy">conditions</a>).</div></details>
    </div>
  </div>
</div>
<div class="barre-achat" id="barre-achat"><span class="prix" id="prix-barre">{{ v0.price | money }}</span><button class="btn" type="button" id="barre-ajouter"><span class="brille"></span>Ajouter au panier</button></div>
<div class="mini-apercu" id="mini-apercu" aria-hidden="true"><div class="mini-vue" id="mini-vue"></div><span>✍️ votre aperçu</span></div>

<section class="section band">
  <div class="wrap">
    <div class="head"><span class="hand">Le 2e est à -50 %…</span><h2>Et pour <em>l'offrir à deux</em> ?</h2></div>
    <div class="grille">
      {%- for p in collections.all.products limit: 5 -%}
        {%- unless p.handle == product.handle -%}{% render 'carte-produit', p: p %}{%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script type="application/ld+json">
{ "@context": "https://schema.org", "@type": "Product", "name": {{ product.title | json }}, "image": {% if product.featured_image %}{{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}{% else %}""{% endif %},
  "description": {{ c.seo | default: product.description | strip_html | json }}, "brand": { "@type": "Brand", "name": {{ shop.name | json }} },
  "offers": { "@type": "Offer", "priceCurrency": "EUR", "price": {{ v0.price | divided_by: 100.0 | json }}, "availability": "https://schema.org/InStock", "url": {{ request.origin | append: product.url | json }} } }
</script>

{% schema %}
{ "name": "Fiche produit Lou", "settings": [] }
{% endschema %}
