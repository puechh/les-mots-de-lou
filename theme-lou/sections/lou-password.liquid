<div class="bientot">
  <img src="{{ 'lou-avatar.webp' | asset_url }}" alt="Lou" width="140" height="140">
  <p class="logo" style="font-size:2.2rem"><span class="logo-les">Les</span> Mots <span class="logo-de">de</span> <span class="logo-lou">Lou</span></p>
  <h1 style="font-size:2.4rem">On prépare <em>vos mots</em>…</h1>
  <p class="small">Des bijoux gravés avec les mots qu'on n'ose pas dire. Ouverture très bientôt : laissez votre e-mail pour être prévenue en premier.</p>
  {%- form 'customer' -%}
    <input type="hidden" name="contact[tags]" value="newsletter,attente">
    {%- if form.posted_successfully? -%}<p class="hand">C'est noté 💗 À très vite !</p>{%- else -%}
    <label class="sr" for="pw-email">E-mail</label><input id="pw-email" type="email" name="contact[email]" placeholder="votre@email.fr" required><button class="btn btn-small" type="submit">Prévenez-moi</button>
    {%- endif -%}
  {%- endform -%}
  <details style="margin-top:20px"><summary class="small">Accès boutique</summary>
    {%- form 'storefront_password' -%}<label class="sr" for="pw">Mot de passe</label><input id="pw" type="password" name="password" placeholder="Mot de passe"><button class="btn btn-small" type="submit">Entrer</button>{%- endform -%}
  </details>
</div>
{% schema %}{ "name": "Mot de passe Lou", "settings": [] }{% endschema %}
