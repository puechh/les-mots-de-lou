{% render 'entete-page', hand: 'Enchantée ✨', titre: "C'est moi, <em>Lou</em>", texte: "La voix des Mots de Lou." %}
<section class="section">
  <div class="wrap lou">
    <figure class="lou-photo"><img src="{{ 'lou-portrait.webp' | asset_url }}" alt="Portrait de Lou" width="1000" height="1250"><figcaption>Lou 💗</figcaption></figure>
    <div>
      <div class="lou-dit" style="margin-bottom:18px">
        <span class="avatar"><img src="{{ 'lou-avatar.webp' | asset_url }}" alt="" width="46" height="46"></span>
        <div class="bulle-lou"><b class="nom">Lou</b><p>Coucou ! Moi c'est Lou. Je suis là pour vous aider à trouver les mots… et le bijou qui va avec 💌</p></div>
      </div>
      <div class="lou-infos" style="margin:0 0 18px"><span>✍️ Gravure en aperçu direct</span><span>💌 Spécialiste des mots doux</span><span>🎁 Je vous aide à choisir</span><span>🙋‍♀️ Une vraie équipe derrière moi</span></div>
      <div class="texte" style="margin:0">{{ page.content }}</div>
    </div>
  </div>
</section>
{% schema %}{ "name": "Page Qui est Lou", "settings": [] }{% endschema %}
