<div class="test rv" id="test-mots">
  <div class="test-top">
    <div class="test-avatar"><img src="{{ 'lou-avatar.webp' | asset_url }}" alt="Lou" width="54" height="54" loading="lazy"></div>
    <p class="bulle" aria-live="polite">Coucou ! Je vais vous aider à trouver le bijou parfait… et les mots qui vont avec 💌</p>
  </div>
  <div class="test-prog" aria-hidden="true"><i></i></div>
  <div class="test-zone"></div>
</div>
<script type="application/json" id="test-produits">
{%- assign handles_test = 'jonc-mes-mots,collier-prenom,collier-souvenir-photo,bracelet-code-secret' | split: ',' -%}
{
{%- for h in handles_test -%}
  {%- assign tp = all_products[h] -%}
  {{ h | json }}: { "title": {{ tp.title | json }}, "url": {{ tp.url | json }}, "price": {{ tp.price | money | json }}, "image": {% if tp.featured_image %}{{ tp.featured_image | image_url: width: 300 | json }}{% else %}""{% endif %} }{% unless forloop.last %},{% endunless %}
{%- endfor -%}
}
</script>
