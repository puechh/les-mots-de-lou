{%- comment -%} En-tête de page commun : petit mot manuscrit, titre, texte et bulle de Lou (facultatifs). {%- endcomment -%}
<div class="page-hero">
  <div class="wrap">
    {%- if hand != blank %}<span class="hand">{{ hand }}</span>{% endif -%}
    <h1>{{ titre }}</h1>
    {%- if texte != blank %}<p>{{ texte }}</p>{% endif -%}
    {%- if bulle != blank -%}
      <div class="lou-dit rv">
        <span class="avatar"><img src="{{ 'lou-avatar.webp' | asset_url }}" alt="" width="46" height="46"></span>
        <div class="bulle-lou"><b class="nom">Lou <small>· avatar de la boutique</small></b><p>{{ bulle }}</p></div>
      </div>
    {%- endif -%}
  </div>
</div>
